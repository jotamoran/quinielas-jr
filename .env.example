# Frontend (públicas, con prefijo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_TITLE=Quinielas JR
# Alias de login para el admin: si se escribe "admin" en el campo correo del login,
# se sustituye por este correo real antes de mandarlo a Supabase.
VITE_ADMIN_ALIAS_EMAIL=

# Serverless (privadas, solo en Vercel — nunca en el bundle del frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# TheSportsDB (thesportsdb.com) — key pública gratis: 123. Con Premium ($9/mes en
# thesportsdb.com, mayor límite de requests) se reemplaza por la key personal del perfil.
SPORTSDB_API_KEY=123
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Quinielas JR
SMTP_FROM_EMAIL=
